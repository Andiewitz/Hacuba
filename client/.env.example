# These are server-only service URLs used by Next route handlers.
AUTH_API_URL=http://localhost:8080
LISTINGS_API_URL=http://localhost:8081
SUPPORT_API_URL=http://localhost:8082
SUPPORT_PROXY_SECRET=

# In production, set this to Terraform's listing_images_cloudfront_domain output.
# In local development, use http://localhost:3000/api/dev-uploads.
LISTINGS_IMAGE_BASE_URL=

# Must exactly match the server-only DISCOVERY_PROXY_SECRET for Listings.
# Never prefix it with NEXT_PUBLIC_.
DISCOVERY_PROXY_SECRET=
