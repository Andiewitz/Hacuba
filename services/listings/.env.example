PORT=8081
# Production: inject this complete encrypted Postgres DSN from Secrets Manager.
# DATABASE_URL=postgresql://hacuba_listings:password@private-rds-endpoint:5432/listings?sslmode=require
# Local Docker Compose only: used to form its private DATABASE_URL.
DB_PASSWORD=change-me
# Must match the auth service JWT_SECRET; generate with openssl rand -hex 32.
JWT_SECRET=change-me-to-64-hex-chars-minimum-please-generate-a-real-secret
# Development only. Set this instead of DATABASE_URL to persist locally without Postgres or Docker.
# Never set in production; production requires DATABASE_URL.
DEV_SQLITE_PATH=
# Production S3. Set both values and run the workload with the Terraform
# listings-image policy; leaving both unset enables local disk uploads only when DEV_SQLITE_PATH is set.
S3_REGION=ap-southeast-1
S3_BUCKET=
# Discovery aggregation worker: uses DATABASE_URL only, never DEV_SQLITE_PATH.
# Leave the interval unset to drain the current queue and exit, or set e.g. 1m.
DISCOVERY_BATCH_SIZE=250
DISCOVERY_WORKER_INTERVAL=
# Shared only between the Next server and Listings API. It authenticates
# personalized discovery requests; never expose it with NEXT_PUBLIC_.
DISCOVERY_PROXY_SECRET=
