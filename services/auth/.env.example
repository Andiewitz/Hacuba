PORT=8080
# Production: inject the encrypted DATABASE_URL from the auth database secret.
# Docker Compose uses its private auth-db hostname instead.
DATABASE_URL=postgres://auth_service:change-me@auth-db:5432/auth?sslmode=disable
# Generate with: openssl rand -hex 32 (min 32 bytes / 64 hex chars)
JWT_SECRET=change-me-to-64-hex-chars-minimum-please-generate-a-real-secret
ACCESS_TTL=15m
REFRESH_TTL=168h
COOKIE_DOMAIN=
COOKIE_SECURE=false
